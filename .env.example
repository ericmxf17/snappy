# Copy this file to .env and fill in real values. .env is gitignored.

# From the SnapTrade dashboard (Personal account API keys).
# These are the same PERS-... credentials the snaptrade CLI uses.
SNAPTRADE_CLIENT_ID=PERS-XXXXXXXXXXXXXXXXX
SNAPTRADE_CONSUMER_KEY=your_consumer_key_here

# From console.anthropic.com. Separate from any Claude Code login.
# Local development only; omit when using the hosted service.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Hosted-client alternative. The invite is redeemed once, then replaced by a
# session token in the macOS Keychain; it need not remain in this file.
# SNAPPY_BACKEND_URL=https://snappy-agent.example.com
# SNAPPY_BACKEND_INVITE=one-time-code
